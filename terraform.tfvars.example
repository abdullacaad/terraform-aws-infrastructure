# Copy to terraform.tfvars and fill in your own values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars with real IPs / key names if it holds secrets.
# (It is git-ignored — see .gitignore.)

project_name   = "terraform-infra"
environment    = "dev"
aws_region     = "us-east-1"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

instance_type      = "t3.micro"
web_instance_count = 1
app_instance_count = 0

# Create a key pair first: AWS Console > EC2 > Key Pairs > Create.
# Put its name here, e.g. key_name = "abdullah-laptop"
key_name = ""

# YOUR public IP only, e.g. "203.0.113.10/32" — find it at https://checkip.amazonaws.com
allowed_ssh_cidr = "0.0.0.0/0" # <-- change this before any real use

# false = no NAT Gateway (~$0 extra). true = private servers can reach
# the internet, ~$32/month. Keep false unless you need it.
enable_nat_gateway = false

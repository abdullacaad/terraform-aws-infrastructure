# Generated by Terraform — do not edit by hand.
# Re-generated on every `terraform apply`.
[webservers]
%{ for ip in web_ips ~}
${ip} ansible_user=${ssh_user} ansible_ssh_private_key_file=${key_path}
%{ endfor ~}

[appservers]
%{ for ip in app_ips ~}
${ip} ansible_user=${ssh_user} ansible_ssh_private_key_file=${key_path}
%{ endfor ~}

[all:vars]
ansible_python_interpreter=/usr/bin/python3
